; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is human-readable and can be version-controlled cleanly.

config_version=5

[application]

config/name="Chamber: Cyber Protocol"
config/description="Fast-paced 3D mobile sci-fi arena game optimized for mobile devices."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/game_manager.gd"
AudioController="*res://scripts/audio_synth.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

